{
  "name": "@snakzap/db",
  "version": "0.0.0",
  "private": true,
  "main": "./index.ts",
  "types": "./index.ts",
  "exports": {
    ".": "./index.ts",
    "./schema": "./src/schema/index.ts"
  },
  "scripts": {
    "lint": "tsc --noEmit",
