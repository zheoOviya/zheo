# SnakZap Environment Variables
# Copy this file to .env and fill in the values.
# DO NOT commit .env to version control.

# ============================================
# DATABASE
# ============================================
DATABASE_URL=postgresql://user:password@localhost:5432/snakzap
DATABASE_URL_TEST=postgresql://user:password@localhost:5432/snakzap_test

# ============================================
# REDIS
# ============================================
REDIS_URL=redis://localhost:6379
REDIS_TOKEN=

# ============================================
# JWT AUTHENTICATION (PRD Section EGS Layer 2.3)
# Access Token: 15 min TTL
# Refresh Token: 7 days TTL, HttpOnly cookie
# ============================================
JWT_SECRET=your-jwt-secret-here
JWT_REFRESH_SECRET=your-jwt-refresh-secret-here

# ============================================
# MSG91 SMS PROVIDER (PRD Phase 1: OTP)
# ============================================
MSG91_AUTH_KEY=your-msg91-auth-key
MSG91_TEMPLATE_ID=your-otp-template-id

# ============================================
# RAZORPAY PAYMENT GATEWAY (PRD Phase 1)
# ============================================
RAZORPAY_KEY_ID=your-razorpay-key-id
RAZORPAY_KEY_SECRET=your-razorpay-key-secret
RAZORPAY_WEBHOOK_SECRET=your-razorpay-webhook-secret

# ============================================
# CLOUDINARY / AWS S3 (Menu Photo Upload)
# ============================================
CLOUDINARY_URL=cloudinary://api_key:api_secret@cloud_name
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=your-cloud-name

# ============================================
# GOOGLE MAPS (Traffic ETA, Phase 2)
# ============================================
NEXT_PUBLIC_MAPS_API_KEY=your-google-maps-api-key

# ============================================
# SENTRY (Error Monitoring)
# ============================================
SENTRY_DSN=your-sentry-dsn
NEXT_PUBLIC_SENTRY_DSN=your-public-sentry-dsn

# ============================================
# APP CONFIG
# ============================================
NEXT_PUBLIC_API_URL=http://localhost:3001
# Optional: API origin used to derive the WebSocket endpoint (ws/wss).
# When unset, the browser connects to the same-origin host (preview/dev).
NEXT_PUBLIC_API_BASE=
# Optional: explicit full WebSocket URL (overrides NEXT_PUBLIC_API_BASE).
NEXT_PUBLIC_WS_URL=ws://localhost:3001
NODE_ENV=development

# ============================================
# SECURITY (dev/preview only)
# ============================================
# Enables the on-screen demo OTP and any-6-digit OTP acceptance so the app can
# be exercised without an SMS gateway. Defaults to false; production refuses to
# boot if this is set to true. NEVER set this in a real deployment.
ALLOW_DEV_AUTH_BYPASS=true
